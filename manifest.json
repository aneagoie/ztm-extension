{
  "manifest_version": 3,
  "name": "Zero To Mastery",
  "version": "2024.7.31",
  "description": "Official extension for Zero To Mastery Academy students. (All features disabled - now native to the website)",
  "author": "Sithu Khant",
  "homepage_url": "https://zerotomastery.io/",
  "host_permissions": [
    "https://*.zerotomastery.io/*"
  ],
  "action": {
    "default_title": "Zero To Mastery",
